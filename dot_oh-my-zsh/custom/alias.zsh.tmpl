# GENERAL

# chezmoi
alias cm='chezmoi'
alias cma='cm add'
alias cmf='cm forget'
alias cme='cm edit'
alias cmea='cme --apply'
alias cmm='cm merge'
alias cmd='cm diff'
alias cmap='cm apply'
alias cmu='cm update'
alias cmst='cm status'
alias cmcd='cm cd'
alias cmdo='cm doctor'
alias cmda='cm data'

# git
alias gwip='git add -A; git rm $(git ls-files --deleted) 2> /dev/null; git commit --no-verify --no-gpg-sign --message "--wip-- $(curl -s https://whatthecommit.com/index.txt)"'
alias gwipa='gwip --allow-empty'

# github
alias ghpr='gh pr create --fill'
alias ghprd='ghpr --draft'

# utility
alias as='alias | grep'
alias te='trash-empty -f'

# vscode
c() {
  local directory="${1:-.}"
  local -a workspaces=( "$directory"/*.code-workspace(N) )
  if (( ${#workspaces} )); then
    code "${workspaces[1]}"
  else
    code "$directory"
  fi
}

{{ if eq .profile "axon-ivy" -}}
# AXON IVY

# eclipse
e() {
  (nohup /opt/adoptium/eclipse/eclipse "$@" >/dev/null 2>&1 &) >/dev/null
}
_e_release() {
  local release="$1"
  local -a args=("${@:2}")
  if [[ -z "$release" ]]; then
    echo "No release specified."
    return 1
  fi
  e -data ~/dev/"$release"/workspaces/core "${args[@]}"
}
alias em='_e_release master'
alias e14='_e_release 14.0'
alias e12='_e_release 12.0'
alias e10='_e_release 10.0'
alias e8='_e_release 8.0'

# git
