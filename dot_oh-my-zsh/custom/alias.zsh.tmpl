# maven
_mvn_release() {
  local java_version="$1"
  local release="$2"
  local -a args=("${@:3}")
  if [[ -z "$java_version" ]]; then
    echo "No Java version specified."
    return 1
  fi
  if [[ -z "$release" ]]; then
    echo "No release specified."
    return 1
  fi
  JAVA_HOME="/usr/lib/jvm/temurin-${java_version}-jdk-amd64" mvn --settings "${HOME}/.m2-${release}/settings.xml" "${args[@]}"
}
alias mvnm='_mvn_release 25 master'
alias mvn14='_mvn_release 25 14.0'
alias mvn12='_mvn_release 21 12.0'
alias mvn10='_mvn_release 17 10.0'
alias mvn8='_mvn_release 11 8.0'

